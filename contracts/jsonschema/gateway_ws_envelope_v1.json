    "GatewayCommandV1": {
      "$comment": "deadline_at must be after created_at; this cross-field ordering rule is enforced by the Pydantic model only.",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "capability": {
                "enum": [
                  "agent.status.read",
                  "context.baseline.collect",
                  "context.health.collect",
                  "context.network.collect"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "dns.resolve"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "family": {
                    "enum": [
                      "any",
                      "ipv4",
                      "ipv6"
                    ]
                  },
                  "target": {
                    "maxLength": 253,
                    "minLength": 1,
                    "pattern": "^(?![\\s\\S]*://)[\\s\\S]*$",
                    "type": "string"
                  }
                },
                "required": [
                  "target",
                  "family"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "network.ping"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "maximum": 5,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "target": {
                    "maxLength": 253,
                    "minLength": 1,
                    "pattern": "^(?![\\s\\S]*://)[\\s\\S]*$",
                    "type": "string"
                  },
                  "timeout_ms": {
                    "maximum": 5000,
                    "minimum": 100,
                    "type": "integer"
                  }
                },
                "required": [
                  "target",
                  "count",
                  "timeout_ms"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "tcp.connect"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "port": {
                    "maximum": 65535,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "target": {
                    "maxLength": 253,
                    "minLength": 1,
                    "pattern": "^(?![\\s\\S]*://)[\\s\\S]*$",
                    "type": "string"
                  },
                  "timeout_ms": {
                    "maximum": 10000,
                    "minimum": 100,
                    "type": "integer"
                  }
                },
                "required": [
                  "target",
                  "port",
                  "timeout_ms"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "route.get"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "maxLength": 253,
                    "minLength": 1,
                    "pattern": "^(?![\\s\\S]*://)[\\s\\S]*$",
                    "type": "string"
                  }
                },
                "required": [
                  "target"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "adapter.list"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "const": "system.service_status"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "service_key": {
                    "enum": [
                      "endpoint_agent",
                      "endpoint_agent_updater"
                    ]
                  }
                },
                "required": [
                  "service_key"
                ],
