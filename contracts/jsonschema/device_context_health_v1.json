{
  "$defs": {
    "HealthResourcesV1": {
      "additionalProperties": false,
      "properties": {
        "free_bytes": {
          "minimum": 0,
          "title": "Free Bytes",
          "type": "integer"
        },
        "load_1m": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Load 1M",
          "type": "number"
        },
        "uptime_seconds": {
          "minimum": 0,
          "title": "Uptime Seconds",
          "type": "integer"
        }
      },
      "required": [
        "uptime_seconds",
        "load_1m",
        "free_bytes"
      ],
      "title": "HealthResourcesV1",
      "type": "object"
    },
    "HealthSectionsV1": {
      "additionalProperties": false,
      "properties": {
        "resources": {
          "$ref": "#/$defs/HealthResourcesV1"
        },
        "server": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServerHealthV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "services": {
          "items": {
            "$ref": "#/$defs/HealthServiceV1"
          },
          "maxItems": 64,
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "resources",
        "services"
      ],
      "title": "HealthSectionsV1",
      "type": "object"
    },
    "HealthServiceV1": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "inactive",
            "failed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "HealthServiceV1",
      "type": "object"
    },
    "ServerHealthApplicationV1": {
      "additionalProperties": false,
      "properties": {
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "name": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "ServerHealthApplicationV1",
      "type": "object"
    },
    "ServerHealthServiceV1": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "observed_state": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed State"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "missing",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "ServerHealthServiceV1",
      "type": "object"
    },
    "ServerHealthV1": {
      "additionalProperties": false,
      "properties": {
        "applications": {
          "items": {
            "$ref": "#/$defs/ServerHealthApplicationV1"
          },
          "maxItems": 16,
          "title": "Applications",
          "type": "array"
        },
        "role": {
          "enum": [
            "endpoint_platform",
            "openvpn",
            "directum",
            "ad_consultant"
          ],
          "title": "Role",
          "type": "string"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServerHealthServiceV1"
          },
          "maxItems": 16,
          "title": "Services",
          "type": "array"
        },
        "volumes": {
          "items": {
            "$ref": "#/$defs/ServerHealthVolumeV1"
          },
          "maxItems": 16,
          "title": "Volumes",
          "type": "array"
        }
      },
      "required": [
        "role",
        "services",
        "volumes",
        "applications"
      ],
      "title": "ServerHealthV1",
      "type": "object"
    },
    "ServerHealthVolumeV1": {
      "additionalProperties": false,
      "properties": {
        "free_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Free Bytes"
        },
        "mount": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Mount",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "warning",
            "critical",
            "missing",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "total_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Bytes"
        },
        "used_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Used Percent"
        }
      },
      "required": [
        "mount",
        "status"
      ],
      "title": "ServerHealthVolumeV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "collected_at": {
      "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "profile": {
      "const": "health_v1",
      "title": "Profile",
      "type": "string"
    },
    "schema_version": {
      "const": "device_context_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "$ref": "#/$defs/HealthSectionsV1"
    },
    "warnings": {
      "items": {
        "enum": [
          "command_failed",
          "command_timed_out",
          "data_truncated",
          "permission_denied",
          "probe_unavailable",
          "redaction_applied",
          "source_unavailable",
          "unsupported_platform"
        ],
        "type": "string"
      },
      "maxItems": 16,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "collected_at",
    "sections"
  ],
  "title": "DeviceContextHealthV1",
  "type": "object"
}
