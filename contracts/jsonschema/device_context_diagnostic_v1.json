{
  "$defs": {
    "DiagnosticProcessV1": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "state": {
          "enum": [
            "running",
            "sleeping",
            "stopped",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "name",
        "state"
      ],
      "title": "DiagnosticProcessV1",
      "type": "object"
    },
    "DiagnosticSectionsV1": {
      "additionalProperties": false,
      "properties": {
        "log_excerpt": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Excerpt"
        },
        "processes": {
          "items": {
            "$ref": "#/$defs/DiagnosticProcessV1"
          },
          "maxItems": 64,
          "title": "Processes",
          "type": "array"
        },
        "reason": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "processes"
      ],
      "title": "DiagnosticSectionsV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "collected_at": {
      "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "profile": {
      "const": "diagnostic_v1",
      "title": "Profile",
      "type": "string"
    },
    "schema_version": {
      "const": "device_context_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "$ref": "#/$defs/DiagnosticSectionsV1"
    },
    "warnings": {
      "items": {
        "enum": [
          "command_failed",
          "command_timed_out",
          "data_truncated",
          "permission_denied",
          "probe_unavailable",
          "redaction_applied",
          "source_unavailable",
          "unsupported_platform"
        ],
        "type": "string"
      },
      "maxItems": 16,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "collected_at",
    "sections"
  ],
  "title": "DeviceContextDiagnosticV1",
  "type": "object"
}
