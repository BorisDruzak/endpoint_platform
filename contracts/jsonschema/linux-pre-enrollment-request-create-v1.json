{
  "$defs": {
    "LinuxNativeSource": {
      "additionalProperties": false,
      "properties": {
        "core_nevra": {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.:-]{2,190}\\.x86_64$",
          "title": "Core Nevra",
          "type": "string"
        },
        "core_rpm_sha256": {
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Core Rpm Sha256",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "user_sensor_nevra": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.:-]{2,190}\\.x86_64$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Sensor Nevra"
        },
        "user_sensor_rpm_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Sensor Rpm Sha256"
        },
        "version": {
          "maxLength": 17,
          "pattern": "^(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "source_revision",
        "core_nevra",
        "core_rpm_sha256"
      ],
      "title": "LinuxNativeSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "hardware_fingerprint": {
      "maxLength": 256,
      "minLength": 8,
      "pattern": "^sha256:[a-z0-9][a-z0-9._-]{1,248}$",
      "title": "Hardware Fingerprint",
      "type": "string"
    },
    "hostname": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Hostname",
      "type": "string"
    },
    "installation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Installation Id",
      "type": "string"
    },
    "macs": {
      "items": {
        "pattern": "^[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Macs",
      "type": "array"
    },
    "manufacturer": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manufacturer"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "native": {
      "$ref": "#/$defs/LinuxNativeSource"
    },
    "platform": {
      "const": "linux",
      "title": "Platform",
      "type": "string"
    },
    "product_uuid": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Uuid"
    },
    "request_capability": {
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "title": "Request Capability",
      "type": "string"
    },
    "requested_at": {
      "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "schema_version": {
      "const": "linux_pre_enrollment_request_create_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "serial": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Serial"
    }
  },
  "required": [
    "schema_version",
    "platform",
    "installation_id",
    "hardware_fingerprint",
    "request_capability",
    "native",
    "requested_at",
    "hostname"
  ],
  "title": "LinuxPreEnrollmentRequestCreateV1",
  "type": "object"
}
