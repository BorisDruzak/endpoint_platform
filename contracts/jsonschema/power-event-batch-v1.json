{
  "$defs": {
    "PowerEventV1": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "event_kind": {
                "enum": [
                  "OS_STARTED",
                  "OS_RESUMED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "const": "transition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "const": "OS_UNEXPECTED_SHUTDOWN_REPORTED"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "const": "reported"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": {
                "not": {
                  "const": "OS_SLEEP_STARTED"
                }
              }
            }
          },
          "then": {
            "properties": {
              "sleep_subtype": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "boot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/=-]*$",
          "title": "Boot Id",
          "type": "string"
        },
        "event_identifier": {
          "format": "uuid",
          "title": "Event Identifier",
          "type": "string"
        },
        "event_kind": {
          "enum": [
            "OS_STARTED",
            "OS_SHUTDOWN_STARTED",
            "OS_SLEEP_STARTED",
            "OS_RESUMED",
            "OS_UNEXPECTED_SHUTDOWN_REPORTED"
          ],
          "title": "Event Kind",
          "type": "string"
        },
        "evidence": {
          "enum": [
            "transition",
            "request",
            "reported"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "native_record_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/=-]*$",
          "title": "Native Record Id",
          "type": "string"
        },
        "observed_at": {
          "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "occurred_at": {
          "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "schema_version": {
          "const": "power_event_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sleep_subtype": {
          "anyOf": [
            {
              "enum": [
                "sleep",
                "hibernate",
                "hybrid",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sleep Subtype"
        },
        "source": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/=-]*$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event_identifier",
        "event_kind",
        "occurred_at",
        "observed_at",
        "boot_id",
        "source",
        "native_record_id",
        "evidence"
      ],
      "title": "PowerEventV1",
      "type": "object"
    },
    "PowerSourceStatusV1": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "READY",
            "DEGRADED",
            "UNAVAILABLE",
            "UNSUPPORTED"
          ],
          "title": "Availability",
          "type": "string"
        },
        "coverage_started_at": {
          "anyOf": [
            {
              "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Started At"
        },
        "loss_count": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Loss Count",
          "type": "integer"
        },
        "reported_at": {
          "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
          "format": "date-time",
          "title": "Reported At",
          "type": "string"
        },
        "reset_count": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Reset Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "power_source_status_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/=-]*$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source",
        "availability",
        "reported_at"
      ],
      "title": "PowerSourceStatusV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "format": "uuid",
      "title": "Batch Id",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/PowerEventV1"
      },
      "maxItems": 128,
      "title": "Events",
      "type": "array"
    },
    "schema_version": {
      "const": "power_event_batch_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_status": {
      "$ref": "#/$defs/PowerSourceStatusV1"
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "events",
    "source_status"
  ],
  "title": "PowerEventBatchV1",
  "type": "object"
}
