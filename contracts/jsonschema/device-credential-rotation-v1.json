{
  "additionalProperties": false,
  "properties": {
    "device_token": {
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "title": "Device Token",
      "type": "string"
    },
    "overlap_expires_at": {
      "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
      "format": "date-time",
      "title": "Overlap Expires At",
      "type": "string"
    },
    "schema_version": {
      "const": "device_credential_rotation_v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "device_token",
    "overlap_expires_at"
  ],
  "title": "DeviceCredentialRotationV1",
  "type": "object"
}
