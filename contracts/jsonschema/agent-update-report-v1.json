{
  "additionalProperties": false,
  "properties": {
    "report_key": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])",
      "title": "Report Key",
      "type": "string"
    },
    "reported_version": {
      "maxLength": 128,
      "minLength": 5,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])",
      "title": "Reported Version",
      "type": "string"
    },
    "safe_code": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Safe Code"
    },
    "schema_version": {
      "const": "agent_update_report_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "applied",
        "failed",
        "rolled_back"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "report_key",
    "status",
    "reported_version"
  ],
  "title": "AgentUpdateReportV1",
  "type": "object"
}
