{
  "$defs": {
    "ActivitySectionsV1": {
      "additionalProperties": false,
      "properties": {
        "browser": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserActivityV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "foreground": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForegroundApplicationV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "idle_seconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idle Seconds"
        },
        "session_state": {
          "enum": [
            "ACTIVE",
            "IDLE",
            "LOCKED",
            "DISCONNECTED",
            "UNKNOWN"
          ],
          "title": "Session State",
          "type": "string"
        },
        "user_login": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Login"
        }
      },
      "required": [
        "session_state"
      ],
      "title": "ActivitySectionsV1",
      "type": "object"
    },
    "BrowserActivityV1": {
      "additionalProperties": false,
      "properties": {
        "browser_family": {
          "enum": [
            "chrome",
            "yandex"
          ],
          "title": "Browser Family",
          "type": "string"
        },
        "domain": {
          "anyOf": [
            {
              "maxLength": 253,
              "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "extension_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extension Version"
        },
        "last_seen_at": {
          "anyOf": [
            {
              "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Seen At"
        },
        "origin": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^https?://[a-z0-9][a-z0-9.-]*(?::[0-9]{1,5})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "sensor_state": {
          "enum": [
            "NOT_APPLICABLE",
            "NEVER_SEEN",
            "ACTIVE",
            "STALE",
            "ERROR"
          ],
          "title": "Sensor State",
          "type": "string"
        }
      },
      "required": [
        "browser_family",
        "sensor_state"
      ],
      "title": "BrowserActivityV1",
      "type": "object"
    },
    "ForegroundApplicationV1": {
      "additionalProperties": false,
      "properties": {
        "application_category": {
          "enum": [
            "browser",
            "office",
            "business_app",
            "system",
            "remote_access",
            "other"
          ],
          "title": "Application Category",
          "type": "string"
        },
        "process_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\\\/\\x00-\\x1f:]+$",
          "title": "Process Name",
          "type": "string"
        }
      },
      "required": [
        "process_name",
        "application_category"
      ],
      "title": "ForegroundApplicationV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "collected_at": {
      "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "profile": {
      "const": "activity_v1",
      "title": "Profile",
      "type": "string"
    },
    "schema_version": {
      "const": "device_context_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "$ref": "#/$defs/ActivitySectionsV1"
    },
    "warnings": {
      "items": {
        "enum": [
          "command_failed",
          "command_timed_out",
          "data_truncated",
          "permission_denied",
          "probe_unavailable",
          "redaction_applied",
          "source_unavailable",
          "unsupported_platform"
        ],
        "type": "string"
      },
      "maxItems": 16,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "collected_at",
    "sections"
  ],
  "title": "DeviceContextActivityV1",
  "type": "object"
}
