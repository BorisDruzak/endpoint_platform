{
  "$defs": {
    "EndpointCapabilityParameterDescriptorV1": {
      "additionalProperties": false,
      "description": "Public, bounded authoring rule for one fixed primitive parameter.",
      "properties": {
        "allowed_sources": {
          "items": {
            "enum": [
              "input",
              "literal"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Allowed Sources",
          "type": "array"
        },
        "default_literal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Default Literal"
        },
        "enum_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Enum Values"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minimum"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "const": false,
          "title": "Secret",
          "type": "boolean"
        },
        "value_type": {
          "enum": [
            "string",
            "integer",
            "enum"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value_type",
        "required",
        "allowed_sources",
        "enum_values",
        "minimum",
        "maximum",
        "default_literal",
        "secret"
      ],
      "title": "EndpointCapabilityParameterDescriptorV1",
      "type": "object"
    },
    "ModuleCapabilityAuthoringV1": {
      "additionalProperties": false,
      "description": "Stable public metadata for one fixed recipe-capable primitive.",
      "properties": {
        "capability": {
          "enum": [
            "dns.resolve",
            "network.ping",
            "tcp.connect",
            "route.get",
            "adapter.list",
            "system.service_status"
          ],
          "title": "Capability",
          "type": "string"
        },
        "consent_required": {
          "const": false,
          "title": "Consent Required",
          "type": "boolean"
        },
        "feature_flag": {
          "enum": [
            "endpoint_network_primitives_enabled",
            "endpoint_read_only_primitives_enabled"
          ],
          "title": "Feature Flag",
          "type": "string"
        },
        "minimum_agent_version": {
          "maxLength": 32,
          "minLength": 5,
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Minimum Agent Version",
          "type": "string"
        },
        "parameter_schema_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Parameter Schema Version",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/EndpointCapabilityParameterDescriptorV1"
          },
          "maxItems": 4,
          "title": "Parameters",
          "type": "array"
        },
        "platforms": {
          "items": {
            "enum": [
              "linux_amd64",
              "windows_amd64"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Platforms",
          "type": "array"
        },
        "policy": {
          "enum": [
            "network_target_policy",
            "none"
          ],
          "title": "Policy",
          "type": "string"
        },
        "result_schema_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Result Schema Version",
          "type": "string"
        },
        "risk": {
          "const": "safe_read",
          "title": "Risk",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "parameter_schema_version",
        "result_schema_version",
        "platforms",
        "minimum_agent_version",
        "risk",
        "consent_required",
        "feature_flag",
        "policy",
        "parameters"
      ],
      "title": "ModuleCapabilityAuthoringV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned, closed discovery response without an execution surface.",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ModuleCapabilityAuthoringV1"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Items",
      "type": "array"
    },
    "schema_version": {
      "const": "endpoint_module_capability_catalog_v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "title": "ModuleCapabilityCatalogV1",
  "type": "object"
}
