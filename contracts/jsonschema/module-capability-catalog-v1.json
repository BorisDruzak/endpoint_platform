{
  "$defs": {
    "ModuleCapabilityAuthoringV1": {
      "additionalProperties": false,
      "description": "Stable public metadata for one fixed recipe-capable primitive.",
      "properties": {
        "capability": {
          "enum": [
            "dns.resolve",
            "network.ping",
            "tcp.connect",
            "route.get",
            "adapter.list",
            "system.service_status"
          ],
          "title": "Capability",
          "type": "string"
        },
        "consent_required": {
          "const": false,
          "title": "Consent Required",
          "type": "boolean"
        },
        "feature_flag": {
          "enum": [
            "endpoint_network_primitives_enabled",
            "endpoint_read_only_primitives_enabled"
          ],
          "title": "Feature Flag",
          "type": "string"
        },
        "minimum_agent_version": {
          "maxLength": 32,
          "minLength": 5,
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Minimum Agent Version",
          "type": "string"
        },
        "parameter_schema_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Parameter Schema Version",
          "type": "string"
        },
        "platforms": {
          "items": {
            "enum": [
              "linux_amd64",
              "windows_amd64"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Platforms",
          "type": "array"
        },
        "policy": {
          "enum": [
            "network_target_policy",
            "none"
          ],
          "title": "Policy",
          "type": "string"
        },
        "result_schema_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Result Schema Version",
          "type": "string"
        },
        "risk": {
          "const": "safe_read",
          "title": "Risk",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "parameter_schema_version",
        "result_schema_version",
        "platforms",
        "minimum_agent_version",
        "risk",
        "consent_required",
        "feature_flag",
        "policy"
      ],
      "title": "ModuleCapabilityAuthoringV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned, closed discovery response without an execution surface.",
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/ModuleCapabilityAuthoringV1"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Capabilities",
      "type": "array"
    },
    "schema_version": {
      "const": "module_capability_catalog_v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "capabilities"
  ],
  "title": "ModuleCapabilityCatalogV1",
  "type": "object"
}
