{
  "additionalProperties": false,
  "properties": {
    "hardware_fingerprint": {
      "maxLength": 256,
      "minLength": 8,
      "pattern": "^sha256:[a-z0-9][a-z0-9._-]{1,248}$",
      "title": "Hardware Fingerprint",
      "type": "string"
    },
    "installation_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Installation Id",
      "type": "string"
    },
    "platform": {
      "enum": [
        "linux",
        "windows"
      ],
      "title": "Platform",
      "type": "string"
    },
    "requested_at": {
      "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "schema_version": {
      "const": "enrollment_request_v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "platform",
    "hardware_fingerprint",
    "installation_id",
    "requested_at"
  ],
  "title": "EnrollmentRequestV1",
  "type": "object"
}
