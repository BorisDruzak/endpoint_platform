{
  "$defs": {
    "DiagnosticCollectionParametersV1": {
      "additionalProperties": false,
      "description": "The only public operation input supported in v1.",
      "properties": {
        "reason": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*://)[^\\x00-\\x1f\\x7f]{1,256}(?![\\s\\S])",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "DiagnosticCollectionParametersV1",
      "type": "object"
    },
    "EndpointOperationCorrelationV1": {
      "additionalProperties": false,
      "description": "Opaque caller correlation that never reaches the endpoint agent.",
      "properties": {
        "request_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "schema_version": {
          "const": "endpoint_operation_correlation_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_entity_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Entity Id",
          "type": "string"
        },
        "source_entity_type": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]{0,63}$",
          "title": "Source Entity Type",
          "type": "string"
        },
        "source_system": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]{0,63}$",
          "title": "Source System",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "source_system",
        "source_entity_type",
        "source_entity_id"
      ],
      "title": "EndpointOperationCorrelationV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Strict service request for one bounded diagnostic collection.",
  "properties": {
    "capability": {
      "const": "context.diagnostic.collect",
      "title": "Capability",
      "type": "string"
    },
    "correlation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndpointOperationCorrelationV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parameters": {
      "$ref": "#/$defs/DiagnosticCollectionParametersV1"
    },
    "schema_version": {
      "const": "endpoint_operation_create_v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "capability",
    "parameters"
  ],
  "title": "EndpointOperationCreateV1",
  "type": "object"
}
