{
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_kind": {
            "enum": [
              "OS_STARTED",
              "OS_RESUMED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "const": "transition"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_kind": {
            "const": "OS_UNEXPECTED_SHUTDOWN_REPORTED"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "const": "reported"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_kind": {
            "not": {
              "const": "OS_SLEEP_STARTED"
            }
          }
        }
      },
      "then": {
        "properties": {
          "sleep_subtype": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "boot_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/=-]*$",
      "title": "Boot Id",
      "type": "string"
    },
    "event_identifier": {
      "format": "uuid",
      "title": "Event Identifier",
      "type": "string"
    },
    "event_kind": {
      "enum": [
        "OS_STARTED",
        "OS_SHUTDOWN_STARTED",
        "OS_SLEEP_STARTED",
        "OS_RESUMED",
        "OS_UNEXPECTED_SHUTDOWN_REPORTED"
      ],
      "title": "Event Kind",
      "type": "string"
    },
    "evidence": {
      "enum": [
        "transition",
        "request",
        "reported"
      ],
      "title": "Evidence",
      "type": "string"
    },
    "native_record_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/=-]*$",
      "title": "Native Record Id",
      "type": "string"
    },
    "observed_at": {
      "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "occurred_at": {
      "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "power_event_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sleep_subtype": {
      "anyOf": [
        {
          "enum": [
            "sleep",
            "hibernate",
            "hybrid",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sleep Subtype"
    },
    "source": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/=-]*$",
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_identifier",
    "event_kind",
    "occurred_at",
    "observed_at",
    "boot_id",
    "source",
    "native_record_id",
    "evidence"
  ],
  "title": "PowerEventV1",
  "type": "object"
}
