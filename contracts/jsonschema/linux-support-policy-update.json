{
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "linux_admin_uid": {
      "anyOf": [
        {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Linux Admin Uid"
    },
    "linux_admin_username": {
      "anyOf": [
        {
          "maxLength": 32,
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Linux Admin Username"
    },
    "operator_public_keys": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Operator Public Keys",
      "type": "array"
    },
    "platform": {
      "const": "linux_amd64",
      "default": "linux_amd64",
      "title": "Platform",
      "type": "string"
    },
    "reason": {
      "maxLength": 256,
      "minLength": 3,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "enabled",
    "reason"
  ],
  "title": "LinuxSupportPolicyUpdate",
  "type": "object"
}
