            "BROWSER_UPLOAD": "#/$defs/BrowserUploadEventV1",
            "PRINT_JOB": "#/$defs/PrintJobEventV1",
            "USB_DEVICE_CONNECTED": "#/$defs/UsbConnectedEventV1",
            "USB_DEVICE_DISCONNECTED": "#/$defs/UsbDisconnectedEventV1"
          },
          "propertyName": "event_type"
