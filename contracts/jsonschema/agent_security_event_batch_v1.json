            "$ref": "#/$defs/UsbConnectedEventV1"
          },
          {
            "$ref": "#/$defs/UsbDisconnectedEventV1"
          },
          {
            "$ref": "#/$defs/PrintJobEventV1"
          },
          {
            "$ref": "#/$defs/BrowserUploadEventV1"
          },
          {
            "$ref": "#/$defs/BrowserPasteEventV1"
