        "occurred_at": {
          "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "policy_id": {
          "format": "uuid",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Policy Version",
          "type": "integer"
        },
        "safe_metadata": {
          "$ref": "#/$defs/BrowserPasteMetadataV1"
        },
        "schema_version": {
          "const": "security_event_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "const": "INFO",
          "title": "Severity",
          "type": "string"
        },
        "user_login": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Login"
        }
      },
      "required": [
        "schema_version",
        "event_identifier",
        "severity",
        "occurred_at",
        "policy_id",
        "policy_version",
        "event_type",
        "channel",
        "safe_metadata"
