    "ModuleOperationStepV1": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "enum": [
            "dns.resolve",
            "network.ping",
            "tcp.connect",
            "route.get",
            "adapter.list",
            "system.service_status"
          ],
          "title": "Capability",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "safe_result": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "adapter_list_result_v1": "#/$defs/AdapterListResultV1",
                  "dns_resolve_result_v1": "#/$defs/DnsResolveResultV1",
                  "network_ping_result_v1": "#/$defs/NetworkPingResultV1",
                  "route_get_result_v1": "#/$defs/RouteGetResultV1",
                  "service_status_result_v1": "#/$defs/ServiceStatusResultV1",
                  "tcp_connect_result_v1": "#/$defs/TcpConnectResultV1"
                },
                "propertyName": "schema_version"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/DnsResolveResultV1"
                },
                {
                  "$ref": "#/$defs/NetworkPingResultV1"
                },
                {
                  "$ref": "#/$defs/TcpConnectResultV1"
                },
                {
                  "$ref": "#/$defs/RouteGetResultV1"
                },
                {
                  "$ref": "#/$defs/AdapterListResultV1"
                },
                {
                  "$ref": "#/$defs/ServiceStatusResultV1"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Safe Result"
        },
        "sequence": {
          "maximum": 7,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "status": {
          "enum": [
            "queued",
            "delivered",
            "acknowledged",
            "running",
            "succeeded",
            "failed",
            "canceled",
            "expired"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "capability",
        "status"
      ],
      "title": "ModuleOperationStepV1",
      "type": "object"
    },
