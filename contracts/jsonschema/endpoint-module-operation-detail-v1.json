          "type": "string"
        },
        "mtu": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Mtu",
          "type": "integer"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "primary": {
          "title": "Primary",
          "type": "boolean"
        },
        "speed_mbps": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Speed Mbps",
          "type": "integer"
        },
        "state": {
          "enum": [
            "up",
            "down",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
