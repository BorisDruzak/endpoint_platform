        "ipv6_addresses": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Ipv6 Addresses",
          "type": "array"
        },
        "kind": {
          "enum": [
            "ethernet",
            "wifi",
            "loopback",
            "tunnel",
            "virtual",
            "unknown"
