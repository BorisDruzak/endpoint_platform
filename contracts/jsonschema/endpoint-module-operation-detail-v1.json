        "adapters": {
          "items": {
            "$ref": "#/$defs/AdapterSummaryItemV1"
          },
          "maxItems": 32,
          "title": "Adapters",
          "type": "array"
        },
        "collected_at": {
          "$comment": "model-only UTC normalization: timezone-aware values are normalized to UTC.",
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "schema_version": {
          "const": "adapter_list_result_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "up_count": {
          "maximum": 32,
          "minimum": 0,
          "title": "Up Count",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "adapter_count",
        "up_count",
        "status",
        "collected_at"
      ],
      "title": "AdapterListResultV1",
      "type": "object"
    },
    "AdapterSummaryItemV1": {
