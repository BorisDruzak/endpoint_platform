#!/bin/sh
set -eu

if [ "$1" = remove ] || [ "$1" = purge ]; then
    dropin=/etc/systemd/system/endpoint-agent-ubuntu.service.d
    for record in "$dropin/90-endpoint-package-upgrade.conf" "$dropin/.endpoint-package-resume"; do
        if [ ! -L "$record" ] && [ -f "$record" ] && grep -Fxq '# Endpoint DEB transaction fence' "$record"; then
            rm -- "$record"
        fi
    done
    rmdir -- "$dropin" 2>/dev/null || true
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
