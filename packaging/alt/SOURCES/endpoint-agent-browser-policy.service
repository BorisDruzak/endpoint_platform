[Unit]
Description=Endpoint Platform restricted browser policy helper
Before=endpoint-agent.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/lib/endpoint-agent/browser-policy-helper
RuntimeDirectory=endpoint-agent-browser-policy
RuntimeDirectoryMode=0755
StateDirectory=endpoint-agent-browser-policy
StateDirectoryMode=0755
ReadWritePaths=/var/lib/endpoint-agent-browser-policy /run/endpoint-agent-browser-policy
ReadWritePaths=-/etc/chromium/policies/managed -/etc/opt/chrome/policies/managed -/etc/opt/yandex/browser/policies/managed
NoNewPrivileges=true
PrivateTmp=true
PrivateUsers=no
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
