# Replace only on the production host; this file is not a runnable secret file.
DATABASE_URL=postgresql+asyncpg://endpoint_platform:REPLACE_ON_HOST@127.0.0.1:5432/endpoint_platform
PUBLIC_BASE_URL=https://endpoint.sosnadmin.local
DEVICE_TOKEN_PEPPER_FILE=/etc/endpoint-platform/secrets/device-token-pepper
SERVICE_TOKEN_PEPPER_FILE=/etc/endpoint-platform/secrets/service-token-pepper
SESSION_SECRET_FILE=/etc/endpoint-platform/secrets/session-secret
ALLOWED_AGENT_CIDRS=192.168.100.0/24,192.168.101.0/24
ALLOWED_ADMIN_CIDRS=192.168.100.0/24,192.168.101.0/24
TRUSTED_PROXY_CIDRS=127.0.0.1/32
ARTIFACT_ROOT=/var/lib/endpoint-platform/artifacts
ENDPOINT_API_WORKERS=1
# SSO remains explicit until issuer/client secrets are configured.
# Supported telemetry and WorkTime are enabled by default; provision a default
# Endpoint policy and verify APPLIED/sensor evidence after deployment.
ENDPOINT_SSO_ENABLED=false
ENDPOINT_WORKTIME_ENABLED=true

ENDPOINT_POLICY_ENABLED=true
ENDPOINT_ACTIVITY_SENSOR_ENABLED=true
ENDPOINT_BROWSER_SENSOR_ENABLED=true
ENDPOINT_DLP_AUDIT_ENABLED=true
# Optional one-time access after authenticated installation and healthy Support 1.0.1 status.
# Explicit existing account only. Comma-separated canonical Ed25519 public keys,
# without options/comments; no passwords or private keys. No renewal on retries.
SUPPORT_GATEWAY_HOST=endpoint.sosnadmin.local
SUPPORT_GATEWAY_PORT=2222
SUPPORT_GATEWAY_HOST_PUBLIC_KEY=
SUPPORT_INSTALL_AUTO_ENABLE=false
SUPPORT_INSTALL_OPERATOR_PUBLIC_KEYS=
SUPPORT_INSTALL_WINDOWS_ADMIN_USERNAME=
# Initial lease 0.25..8 hours; installation intent expires after 15 minutes.
SUPPORT_INSTALL_ACCESS_HOURS=8
# Linux defaults are independent. Never inherit the Windows account or keys.
# Supply an explicitly approved existing name/UID pair and approved public keys.
SUPPORT_LINUX_INSTALL_AUTO_ENABLE=false
SUPPORT_LINUX_INSTALL_OPERATOR_PUBLIC_KEYS=
SUPPORT_LINUX_INSTALL_ADMIN_USERNAME=
SUPPORT_LINUX_INSTALL_ADMIN_UID=
SUPPORT_LINUX_INSTALL_ACCESS_HOURS=8
