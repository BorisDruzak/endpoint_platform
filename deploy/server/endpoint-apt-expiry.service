[Unit]
Description=Check Endpoint Ubuntu and Debian APT metadata expiration
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/endpoint-apt-expiry
ExecStart=/bin/sh /opt/endpoint-apt-expiry/check_endpoint_apt_expiry.sh
TimeoutStartSec=120s
DynamicUser=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
