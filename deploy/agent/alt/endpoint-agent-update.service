[Unit]
Description=Endpoint Platform ALT update applier
Documentation=file:///usr/share/doc/endpoint-agent/ALT_AGENT_INSTALL.md
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=PC_AGENT_DATA_DIR=/var/lib/endpoint-agent
Environment=PC_AGENT_INSTALL_ROOT=/opt/endpoint-agent
Environment=ENDPOINT_AGENT_ALT_UPDATE_MODE=1
ExecStart=/usr/lib/endpoint-agent/apply-pending-alt-update
TimeoutStartSec=180s
ReadWritePaths=/opt/endpoint-agent /var/lib/endpoint-agent
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
