{
  "manifest_version": 3,
  "name": "Endpoint Browser Sensor",
  "version": "0.1.0",
  "description": "Reports bounded browser activity metadata to the local Endpoint Agent.",
  "permissions": ["tabs", "nativeMessaging", "alarms"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["protocol.js", "content.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
